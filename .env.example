# Copy to .env and fill in. Never commit .env — it is gitignored.
# Generate each secret fresh:  openssl rand -base64 32

# MS SQL sa password. Must meet SQL Server complexity rules
# (upper, lower, digit, symbol, >= 8 chars) or the db container exits at boot.
MSSQL_SA_PASSWORD=

# HMAC signing key for subject JWTs. The app refuses to start with this unset
# under the prod profile; a dev default exists in application.yml only.
JWT_SECRET=

# Pepper mixed into every national-ID hash. Losing it makes existing hashes
# unrecoverable; leaking it weakens them. Rotate = re-hash, so treat as permanent.
HASH_PEPPER=

# tf = real TensorFlow models (production image). stub = deterministic numpy
# heuristics for local development on a Python that has no TF wheels.
INFERENCE_BACKEND=tf

SPRING_PROFILES_ACTIVE=default
ATTEMPT_RATE_LIMIT_PER_MINUTE=6
